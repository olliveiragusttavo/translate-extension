{
  "manifest_version": 3,
  "name": "Simple popup translator API",
  "version": "1.2.1",
  "default_locale": "en",

  "description": "Simply displays the MyMemory Translate form in the extension popup.",

  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },

  "action": {
    "default_title": "Simple popup translator API",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },

  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "translatorextension@olliveiragusttavo.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
