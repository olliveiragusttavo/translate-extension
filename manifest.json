{
  "manifest_version": 3,
  "name": "Simple popup translator API",
  "version": "1.0.0",
  "default_locale": "en",

  "description": "Simply displays the Google Translate form in the extension popup.",

  "icons": {
    "48": "assets/icon.png"
  },

  "action": {
    "default_title": "Simple popup translator API",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "assets/icon.png"
    }
  },

  "background": {
    "scripts": ["popup/popup.js"]
  },

  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "translatorextension@olliveiragusttavo.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["popup/popup.js"]
    }
  ]
}
